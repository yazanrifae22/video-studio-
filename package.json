{
  "name": "clips-viral-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "tsx --disable-warning=ExperimentalWarning apps/api/src/server.ts",
    "worker": "tsx --disable-warning=ExperimentalWarning packages/orchestrator/src/worker.ts",
    "studio:dev": "vite --config apps/studio/vite.config.ts",
    "studio:build": "vite build --config apps/studio/vite.config.ts",
    "start": "npm run studio:build && tsx --disable-warning=ExperimentalWarning apps/api/src/server.ts --with-worker",
    "cli": "tsx --disable-warning=ExperimentalWarning packages/orchestrator/src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
